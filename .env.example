SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required - Google Gemini API Key
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Stripe — required for the Pro paywall.
# Create a product in the Stripe dashboard with two recurring prices
# (monthly + annual) and paste the price IDs below.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...

# Public base URL used for Stripe success/cancel redirects
SITE_URL=http://localhost:3000
