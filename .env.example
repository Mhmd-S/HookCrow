SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required - Google Gemini API Key
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Public base URL used for canonical links, sitemap and og: tags
SITE_URL=http://localhost:3000

# Shared secret for POST /api/internal/discovery/tick (the scheduled ingest).
# Generate with: openssl rand -hex 32
# Must match the DISCOVERY_TICK_SECRET GitHub Actions repo secret.
NUXT_DISCOVERY_TICK_SECRET=
# Max videos ingested per tick invocation. Defaults to 50 when unset.
NUXT_DISCOVERY_DAILY_CAP=
